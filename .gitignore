# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log

# local test artifacts
_gen_test.json
scripts/*.html
# 시각 검증 스크린샷 (_*FigShot.mjs 산출물) — 스크립트는 커밋하고 이미지는 제외
scripts/_*.png
/acdc.png
/acdc.svg
/opamp_generic.svg

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 사용자가 직접 입력·저장한 원본 문제 풀이 (런타임 생성 데이터)
/data/
/thevenin_generic.svg
/seq_circuit.svg
/seq_wave.svg

# 시각 검증용 헤드리스 크롬 프로필 (scripts/verifyNotesViewer.mjs)
/scripts/_chrome-profile/

# dev 서버 로그
.next-dev.out

# 빌드·터널 실행 로그 (터널 URL이 들어간다)
build*.log
tunnel.log
server.log
